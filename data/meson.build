install_data('kimaitimetracker.plugin',
  install_dir: PLUGINS_INSTALL_DIR
)

install_data('io.grnbk.kimaitimetracker.gschema.xml',
  install_dir: join_paths(get_option('datadir'), 'glib-2.0', 'schemas')
)

install_data(
  'kimai-timetracker-paused.svg',
  'kimai-timetracker-running.svg',
  'kimai-timetracker.svg',
  install_dir : join_paths(get_option('datadir'), 'icons', 'hicolor', '16x16', 'status')
)